# Reaction Rush v2 — example environment configuration
#
# Copy this file to ".env" to override server defaults without CLI flags.
# CLI flags always take precedence over environment variables.
# (A tiny built-in reader loads .env; python-dotenv is NOT required.)

# Network
RR_HOST=127.0.0.1
RR_PORT=5000
RR_ACCESS_CODE=RED123

# Match defaults
RR_MIN_PLAYERS=2
RR_MAX_PLAYERS=8
RR_ROUNDS=5
RR_MODE=classic

# Persistence (SQLite)
RR_DB_PATH=reaction_rush.db
RR_PERSISTENCE=true

# Fairness
RR_LATENCY_COMP=true

# Logging
RR_LOG_LEVEL=INFO
RR_LOG_FILE=
